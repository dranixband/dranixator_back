# Server port. Locally defaults to 3001.
# On Railway: leave UNSET — Railway injects its own PORT automatically.
PORT=3001

# Comma-separated list of allowed frontend origins (CORS).
# IMPORTANT: use scheme + host only, no path. Browsers send Origin without the path.
# Local dev:   http://localhost:5173
# Production:  https://dranixband.github.io
# Both at once (recommended for Railway):
#   CLIENT_URL=http://localhost:5173,https://dranixband.github.io
CLIENT_URL=http://localhost:5173
